    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "openid-client": "^6.9.1",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.18",
