# Letters and digits only: this value goes into a connection URL as-is.
POSTGRES_PASSWORD=

# Encrypts the networks' credentials in the database. Generate once with
#   openssl rand -base64 32
# and keep it with your backups: without it the stored credentials are
# unreadable and every account has to be connected again.
BMM_SECRET_KEY=

# The address you open BMM at. Required for OIDC, recommended always.
# BMM_PUBLIC_URL=https://bmm.example.com
# Set to true when BMM sits behind a reverse proxy that sets X-Forwarded-*.
# BMM_TRUST_PROXY=true

# Optional: require this value when creating the first admin.
# BMM_SETUP_TOKEN=

# Optional: sign in through any OpenID Connect provider (Pocket ID, Authentik, Keycloak, ...).
# Redirect URI to register at the provider: <BMM_PUBLIC_URL>/api/v1/auth/oidc/callback
# BMM_OIDC_ISSUER=https://id.example.com
# BMM_OIDC_CLIENT_ID=
# BMM_OIDC_CLIENT_SECRET=
# BMM_OIDC_NAME=Pocket ID
# BMM_OIDC_ALLOWED_EMAIL=you@example.com
# BMM_PASSWORD_LOGIN=false

# Instagram downloads images from a public https address. Point one at this
# instance's /public/ path (see docs/public-media.md) and name it here.
# BMM_PUBLIC_MEDIA_URL=https://media.example.com
